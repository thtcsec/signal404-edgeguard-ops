{
  "title": "EdgeGuard Fleet Operations",
  "description": "Detect to Verify for thermal throttling on edge camera fleets. Logs list queries service:edgeguard-ops (Agent file-tail). No device_id template variable: file-tail logs are not tagged device_id, and * would hide them.",
  "widgets": [
    {
      "definition": {
        "title": "GPU temperature (by device)",
        "type": "timeseries",
        "requests": [
          {
            "display_type": "line",
            "q": "avg:edgeguard.device.gpu_temperature{*} by {device_id}"
          }
        ],
        "yaxis": { "include_zero": false },
        "markers": [
          {
            "value": "y = 85",
            "display_type": "error dashed",
            "label": "thermal threshold 85C"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Inference latency (ms)",
        "type": "timeseries",
        "requests": [
          {
            "display_type": "line",
            "q": "avg:edgeguard.device.inference_latency{*} by {device_id}"
          }
        ],
        "markers": [
          {
            "value": "y = 100",
            "display_type": "warning dashed",
            "label": "latency threshold 100ms"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "FPS (safe mode recovery is not 30 FPS)",
        "type": "timeseries",
        "requests": [
          {
            "display_type": "line",
            "q": "avg:edgeguard.device.fps{*} by {device_id}"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Packet loss percent (network contrast)",
        "type": "timeseries",
        "requests": [
          {
            "display_type": "line",
            "q": "avg:edgeguard.device.packet_loss{*} by {device_id}"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Active incidents",
        "type": "timeseries",
        "requests": [
          {
            "display_type": "bars",
            "q": "avg:edgeguard.incident.active{*}"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Remediation actions",
        "type": "timeseries",
        "requests": [
          {
            "display_type": "bars",
            "q": "sum:edgeguard.remediation.count{*}.as_count()"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Incident and remediation logs",
        "type": "list_stream",
        "requests": [
          {
            "response_format": "event_list",
            "query": {
              "data_source": "logs_stream",
              "query_string": "service:edgeguard-ops (\"Incident RESOLVED\" OR \"Remediation applied\" OR \"Incident entered RECOVERING\")"
            },
            "columns": [
              { "field": "timestamp", "width": "auto" },
              { "field": "service", "width": "compact" },
              { "field": "content", "width": "full" }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "GPU now (C)",
        "type": "query_value",
        "requests": [
          {
            "q": "avg:edgeguard.device.gpu_temperature{*}",
            "aggregator": "last"
          }
        ],
        "autoscale": false,
        "precision": 1,
        "custom_unit": "C"
      }
    },
    {
      "definition": {
        "title": "FPS now",
        "type": "query_value",
        "requests": [
          {
            "q": "avg:edgeguard.device.fps{*}",
            "aggregator": "last"
          }
        ],
        "autoscale": false,
        "precision": 0
      }
    }
  ],
  "layout_type": "ordered",
  "notify_list": [],
  "template_variables": [],
  "reflow_type": "auto"
}
