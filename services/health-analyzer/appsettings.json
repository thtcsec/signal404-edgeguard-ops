{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "edgeguard",
    "TelemetryCollection": "telemetry",
    "IncidentsCollection": "incidents",
    "TelemetryTimeField": "timestamp",
    "TelemetryMetaField": "metadata",
    "TelemetryExpireAfterSeconds": 1209600
  },
  "Observability": {
    "ServiceName": "edgeguard-health-analyzer",
    "DatadogEnabled": false,
    "AgentHost": "127.0.0.1",
    "DogStatsDPort": 8125,
    "TraceAgentPort": 8126
  }
}
