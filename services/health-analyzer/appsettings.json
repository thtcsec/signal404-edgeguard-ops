{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "edgeguard",
    "TelemetryCollection": "telemetry",
    "IncidentsCollection": "incidents",
    "TelemetryTimeField": "timestamp",
    "TelemetryMetaField": "metadata",
    "TelemetryExpireAfterSeconds": 1209600
  },
  "Analyzer": {
    "IntervalSeconds": 10,
    "LookbackMinutes": 10,
    "GpuTemperatureThresholdC": 85,
    "GpuTemperatureRiseC": 8,
    "InferenceLatencyThresholdMs": 100,
    "InferenceLatencyRiseMs": 40,
    "FpsFloor": 16,
    "PacketLossMaxPct": 2
  },
  "Observability": {
    "ServiceName": "edgeguard-health-analyzer",
    "DatadogEnabled": false,
    "AgentHost": "127.0.0.1",
    "DogStatsDPort": 8125,
    "TraceAgentPort": 8126,
    "EnvironmentName": "development",
    "Version": "0.1.0",
    "LogDirectory": ".logs"
  }
}
