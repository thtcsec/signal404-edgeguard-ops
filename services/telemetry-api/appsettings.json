{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "edgeguard",
    "DevicesCollection": "devices",
    "TelemetryCollection": "telemetry",
    "IncidentsCollection": "incidents",
    "RemediationActionsCollection": "remediation_actions",
    "TelemetryTimeField": "timestamp",
    "TelemetryMetaField": "metadata",
    "TelemetryGranularity": "seconds",
    "TelemetryExpireAfterSeconds": 1209600
  },
  "Observability": {
    "ServiceName": "edgeguard-telemetry-api",
    "DatadogEnabled": false,
    "AgentHost": "127.0.0.1",
    "DogStatsDPort": 8125,
    "TraceAgentPort": 8126
  }
}
