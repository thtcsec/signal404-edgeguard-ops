{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "edgeguard",
    "DevicesCollection": "devices",
    "TelemetryCollection": "telemetry",
    "IncidentsCollection": "incidents",
    "RemediationActionsCollection": "remediation_actions"
  },
  "Remediation": {
    "PollIntervalSeconds": 5,
    "ObservationSeconds": 20,
    "RecoveredGpuTemperatureMaxC": 75,
    "RecoveredInferenceLatencyMaxMs": 80,
    "RecoveredFpsMin": 18,
    "RecentTelemetrySeconds": 30
  },
  "Observability": {
    "ServiceName": "edgeguard-response-worker",
    "DatadogEnabled": false,
    "AgentHost": "127.0.0.1",
    "DogStatsDPort": 8125,
    "TraceAgentPort": 8126
  }
}
