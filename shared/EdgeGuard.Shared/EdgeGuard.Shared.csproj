<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>EdgeGuard.Shared</RootNamespace>
    <AssemblyName>EdgeGuard.Shared</AssemblyName>
    <Description>Shared contracts and MongoDB persistence for EdgeGuard Ops.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bundle includes Datadog.Trace + native profiler assets under output/datadog/ -->
    <PackageReference Include="Datadog.Trace.Bundle" Version="3.55.1" />
    <PackageReference Include="DogStatsD-CSharp-Client" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.4.0" />
  </ItemGroup>
</Project>
