# Local configuration contract for the pre-hackathon scaffold.
# Copy to .env for your machine. Never commit .env or real credentials.
# ASP.NET Core reads the MongoDb__ and Observability__ variables.
# Datadog agent variables are reserved for the official build window.

MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=edgeguard
MongoDb__TelemetryExpireAfterSeconds=1209600

Observability__ServiceName=edgeguard-ops
Observability__DatadogEnabled=false
Observability__AgentHost=127.0.0.1
Observability__DogStatsDPort=8125
Observability__TraceAgentPort=8126

EDGEGUARD_TELEMETRY_URL=http://localhost:5080
EDGEGUARD_DEVICE_COUNT=1
EDGEGUARD_INTERVAL_SECONDS=1
EDGEGUARD_SCENARIO=NORMAL

# Leave blank. The Datadog agent is not started by this scaffold.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=edgeguard-ops
DD_ENV=development
DD_VERSION=scaffold
DD_AGENT_HOST=127.0.0.1
DD_TRACE_AGENT_PORT=8126
DD_DOGSTATSD_PORT=8125
DD_LOGS_ENABLED=false
DD_APM_ENABLED=false
DD_TRACE_ENABLED=false
